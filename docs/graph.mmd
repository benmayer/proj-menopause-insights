---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	fetch(fetch)
	analyse(analyse)
	retrieve(retrieve)
	write(write)
	check(check)
	__end__([<p>__end__</p>]):::last
	__start__ --> fetch;
	analyse --> retrieve;
	check -. &nbsp;end&nbsp; .-> __end__;
	check -.-> write;
	fetch --> analyse;
	retrieve --> write;
	write --> check;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
